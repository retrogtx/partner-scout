# One of these two. OpenRouter wins if both are set; SCOUT_AI_PROVIDER forces one.
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
# SCOUT_AI_PROVIDER=openrouter | gateway
# SCOUT_MODEL=anthropic/claude-opus-5

# Only needed locally. In the hosted runtime Whop injects the app key for
# requests to api.whop.com, so leave this unset in production.
WHOP_API_KEY=

# Optional. Without it, report history lives in worker memory and does not survive.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
