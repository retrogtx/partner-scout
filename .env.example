# One of these two. OpenRouter wins if both are set; SCOUT_AI_PROVIDER forces one.
# Note the free tier has a ~50 model-requests/day cap and a full run is 8-11 calls.
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
# SCOUT_AI_PROVIDER=openrouter | gateway
# SCOUT_MODEL=anthropic/claude-opus-5

# Must be an APP api key, not a Company one - public-graphql rejects company keys.
# Dashboard > Developer > Apps > your app > Get started > Set up your local environment.
WHOP_API_KEY=
APP_ID=

# 1 = allow requests with no Whop token (needed for standalone / public use).
# A presented token is always verified regardless.
ALLOW_ANONYMOUS=1

# Optional. Without it, report history lives in worker memory and does not survive.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
